// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "icon_theme": "Material Icon Theme",
  "session": {
    "trust_all_worktrees": true,
  },
  "ssh_connections": [
    {
      "host": "filaco.dev",
      "username": "filaco",
      "port": 40697,
      "args": [],
      "projects": [
        {
          "paths": ["/home/filaco/Projects/alice"],
        },
      ],
    },
  ],
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."],
    },
    "Cangjie": {
      "language_servers": ["cangjie-lsp"],
    },
    "Meson": {
      "language_servers": ["mesonlsp"],
    },
  },
  "file_types": {
    "Cangjie": ["cj"],
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    "cangjie-lsp": {
      "settings": {
        "serverPath": "/home/filaco/.local/bin/cjls",
      },
    },
  },
}
